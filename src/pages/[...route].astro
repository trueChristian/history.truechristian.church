---
import fs from 'node:fs';
import SiteLayout from '../layouts/SiteLayout.astro';
import Timeline from '../components/Timeline.astro';
import type {PreparedPage} from '../lib/model';
export function getStaticPaths(){
  const pages=JSON.parse(fs.readFileSync('.history-data/pages.json','utf8')) as PreparedPage[];
  return pages.map(page=>({params:{route:page.route.replace(/\/$/,'')||undefined},props:{page}}));
}
interface Props {page:PreparedPage}
const {page}=Astro.props;
const isAtlas=['','timeline/','branches/'].includes(page.route);
---
<SiteLayout page={page}>
  {isAtlas ? <Timeline initialKind={page.route==='branches/'?'tradition':''} /> : <Fragment set:html={page.body} />}
  {isAtlas && page.route==='' && <Fragment set:html={page.body} />}
</SiteLayout>
