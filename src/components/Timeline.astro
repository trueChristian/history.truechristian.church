---
import fs from 'node:fs';
import {ERAS} from '../lib/history.mjs';
import {translate} from '../lib/localization.mjs';
import {selectTimeline,timelineMarkup} from '../lib/timeline';
import type {HistoryRecord,BranchData} from '../lib/model';
interface Props {initialKind?:string;locale:string;ui:Record<string,string>}
const {initialKind='',locale,ui}=Astro.props;
const t=(key:string,vars:Record<string,string|number>={})=>translate(ui,key,vars);
const records=JSON.parse(fs.readFileSync(`.history-public/assets/${locale}/catalog.json`,'utf8')) as HistoryRecord[];
const branches=JSON.parse(fs.readFileSync('content/branches.json','utf8')) as BranchData;
const base=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/${locale}`;
const initial=selectTimeline(records,branches,{q:'',era:'',kind:initialKind,family:'',direction:'newest',sources:false});
---
<section class="atlas-intro">
  <p class="eyebrow">{t('A True Christian Church · Our Anabaptist history')}</p>
  <h1>{t('Follow the witness.')}<br /><em>{t('Trace the living streams.')}</em></h1>
  <p class="lead">{t('A connected history of faith, discipleship, and community. Follow the Radical Reformation and its branches, and read the witnesses preserved in Martyrs’ Mirror.')}</p>
  <div class="atlas-statistics"><span><strong>{records.filter(r=>r.kind==='story').length.toLocaleString(locale)}</strong>{t('source accounts & sections')}</span><span><strong>{records.filter(r=>r.kind==='tradition').length}</strong>{t('traditions & shared histories')}</span><span><strong>{branches.edges.length}</strong>{t('branch connections')}</span></div>
</section>
<section class="history-atlas" data-initial-kind={initialKind} aria-label={t("Interactive Anabaptist history timeline")}>
  <aside class="atlas-navigation">
    <p class="eyebrow">{t('Navigate the history')}</p>
    <nav aria-label={t("Timeline eras")}>
      {ERAS.map(era=><a href={`${base}/timeline/#era-${era.id}`} data-atlas-era={era.id}><span>{era.short}</span><strong>{t(era.title)}</strong></a>)}
    </nav>
    <p class="atlas-nav-note">{t('Follow the connected lines. Open any name or event to read its history.')}</p>
    <a class="text-link" href={`${base}/search/`}>{t('Search the complete text →')}</a>
  </aside>
  <div class="atlas-main">
    <form id="timeline-filters" class="atlas-filters">
      <label class="atlas-query">{t('Find in the timeline')}<input name="q" type="search" placeholder={t("Name, place, or event")} /></label>
      <label>{t('Era')}<select name="era"><option value="">{t('All eras')}</option>{ERAS.map(era=><option value={era.id}>{t(era.title)}</option>)}</select></label>
      <label>{t('Family')}<select name="family"><option value="">{t('Every stream')}</option>{branches.families.map(f=><option value={f.id}>{t(f.title)}</option>)}</select></label>
      <label>{t('Include')}<select name="kind"><option value="">{t('People, events & streams')}</option><option value="tradition" selected={initialKind==='tradition'}>{t('Branches & institutions')}</option><option value="event">{t('Events')}</option><option value="person">{t('People')}</option><option value="place">{t('Places')}</option><option value="story">{t('Martyrs’ Mirror accounts')}</option></select></label>
      <label>{t('Read through time')}<select name="direction"><option value="newest">{t('Present → beginnings')}</option><option value="oldest">{t('Beginnings → present')}</option></select></label>
      <label class="atlas-checkbox"><input name="sources" type="checkbox" />{t('Include every source account')}</label>
      <button class="button" type="reset">{t('Reset view')}</button>
    </form>
    <p id="timeline-status" class="atlas-status" role="status">{t('{count} histories · showing {shown} · {direction}',{count:initial.length,shown:initial.length,direction:t('present to beginnings')})}</p>
    <div class="atlas-legend"><span class="legend-thread"></span>{t('Branch development')}<span class="legend-thread is-dashed"></span>{t('Influence or shared fellowship')}<a href={`${base}/about/`}>{t('About this archive')}</a></div>
    <div class="atlas-canvas">
      <svg id="timeline-threads" aria-label={t("Connections between the visible branch histories")} role="img"></svg>
      <div id="timeline-entries" set:html={timelineMarkup(initial,records,branches,base,ui)} />
    </div>
    <button id="timeline-more" class="button more-button" type="button" hidden>{t('Show more accounts')}</button>
    <noscript><p>{t('The timeline remains readable without JavaScript. All accounts are also available in the story collection.')}</p></noscript>
  </div>
</section>
<script>
  import '../timeline';
</script>
